# Linux / Docker Compose 生产环境模板：复制为 .env 并填写真实值
# cp .env.prod.example .env && chmod 600 .env

NODE_ENV=production
PORT=3001
# 应用对外端口（避开 80/443/3306 等已占用端口）
APP_PORT=8080

# 容器内 MySQL 主机名固定为 mysql；密码需与 MYSQL_PASSWORD 一致
DATABASE_URL="mysql://la:CHANGE_ME@mysql:3306/oneperson_la"
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_PASSWORD=CHANGE_ME

# 生产必须使用独立随机值：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_HEX
ENCRYPTION_KEY=CHANGE_ME_64_HEX

# 留空则对话走内置离线 Mock；填入后走真实模型
LLM_API_KEY=

# HTTPS 部署时置 true（Refresh Cookie 加 Secure）
COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:8080

# Obsidian 仓库宿主目录（只读挂载到容器 /vault）
OBSIDIAN_VAULT=/mnt/nextcloud_data
