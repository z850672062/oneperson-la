{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "sticky"
  ],
  "remote": {
    "urls": [
      "http://*",
      "https://*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging"
  ]
}
