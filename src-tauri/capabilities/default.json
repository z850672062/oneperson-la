{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "sticky"
  ],
  "remote": {
    "urls": [
      "http://*:*/*",
      "https://*:*/*",
      "http://*/*",
      "https://*/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-save-server-url",
    "allow-get-server-url",
    "allow-set-sticky-pinned",
    "allow-get-sticky-pinned",
    "allow-set-sticky-collapsed",
    "allow-hide-sticky-window",
    "allow-open-main-window"
  ]
}
